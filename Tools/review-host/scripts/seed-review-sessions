#!/bin/bash
# Reset and reseed the reviewer's tmux sessions. Runs as root (container
# entrypoint / cloud-init cron); the sessions belong to `review`.
set -u
pkill -u review 2>/dev/null || true
sleep 1
rm -rf /home/review/project
su - review -s /bin/bash <<'SEED'
mkdir -p ~/project
printf '# notes\n\n- check deploy at 15:00\n- rotate api key\n' > ~/project/notes.md
tmux new-session -d -s main -n editor
tmux send-keys -t main:0 'vim ~/project/notes.md' Enter
tmux new-window -t main:1 -n server /usr/local/bin/demo-server-log
tmux new-window -t main:2 -n logs /usr/local/bin/demo-worker-log
tmux select-window -t main:1
tmux new-session -d -s build /usr/local/bin/demo-build-loop
tmux new-session -d -s logs /usr/local/bin/demo-worker-log
tmux new-session -d -s agent -n cc /usr/local/bin/demo-agent-cc
tmux new-window -t agent:1 -n cx /usr/local/bin/demo-agent-cx
tmux new-window -t agent:2 -n pi /usr/local/bin/demo-agent-pi
tmux select-window -t agent:0
SEED

# The HERDR-backend half of the same demo (skips itself where herdr isn't
# installed). It runs after the pkill above, so it always starts from a dead
# herdr server — a reseed is a full reset for both backends.
su - review -s /bin/bash -c /usr/local/bin/seed-review-herdr || \
    echo "seed-review-herdr failed — tmux sessions are still seeded" >&2
