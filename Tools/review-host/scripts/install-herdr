#!/bin/bash
# Install the pinned herdr release binary (herdr.dev) on the reviewer demo
# host, so the box demonstrates Multiplex's HERDR session backend as well as
# tmux. Runs as root, idempotent — an already-pinned binary is left alone.
#
# Pinned, never "latest": the app parses herdr's socket API (protocol 17,
# written against 0.7.5) and a review host must not drift under a live
# submission. Upstream ships one static-pie binary per arch with no checksum
# file, so the hashes below were taken from the v0.7.5 assets on 2026-08-02
# and are verified before anything is installed. When bumping the version,
# recompute both.
#
# The install is a provisioning-time download: the running host's egress is
# firewalled, which is fine — herdr itself needs no network (its clients and
# server talk over a Unix socket) and `herdr update` is never run here.
set -euo pipefail

VERSION=0.7.5
case "$(uname -m)" in
  x86_64|amd64)
    ASSET=herdr-linux-x86_64
    SHA=3dc83288073e4c2d3c679a30e7be97bcca9141c6fd17dbbb9219142e95c59253 ;;
  aarch64|arm64)
    ASSET=herdr-linux-aarch64
    SHA=32e763a1499a6b694b1d708e4f062b743be1da9f34fcfa4d212d6db6fe09a8b9 ;;
  *)
    echo "herdr: no published binary for $(uname -m) — skipping" >&2; exit 0 ;;
esac

DEST=/usr/local/bin/herdr
if [ -x "$DEST" ] && "$DEST" --version 2>/dev/null | grep -Fq "herdr $VERSION"; then
  echo "herdr $VERSION already installed"
  exit 0
fi

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
curl -fsSL --retry 3 -o "$TMP/herdr" \
  "https://github.com/herdrdev/herdr/releases/download/v$VERSION/$ASSET"
echo "$SHA  $TMP/herdr" | sha256sum -c - >/dev/null || {
  echo "herdr: checksum mismatch for $ASSET — refusing to install" >&2; exit 1
}
install -m 755 "$TMP/herdr" "$DEST"
"$DEST" --version
