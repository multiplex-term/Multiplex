# Copy to fastlane/.env (git-ignored) and fill in. fastlane loads it
# automatically. Nothing here ships in the app.

# App Store Connect API key (Users and Access → Integrations → App Store
# Connect API → Team Keys; role: App Manager). Download the .p8 once into
# fastlane/keys/ (git-ignored).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=fastlane/keys/AuthKey_XXXXXXXXXX.p8

# Developer team
FASTLANE_TEAM_ID=C6EUM5DVB3
FASTLANE_APPLE_ID=jhen@bricks.tools

# App Review / Beta App Review contact
REVIEW_CONTACT_FIRST=Jhen-Jie
REVIEW_CONTACT_LAST=Hong
REVIEW_CONTACT_EMAIL=jhen@bricks.tools
REVIEW_CONTACT_PHONE=

# Reviewer demo host (see docs/appstore/release-playbook.md → demo-host runbook)
DEMO_SSH_USER=review
DEMO_SSH_PASSWORD=

# TestFlight
TESTFLIGHT_EXTERNAL_GROUP=Multiplex Beta
