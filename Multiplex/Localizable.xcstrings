    "Not a host key. Paste a SHA256: fingerprint, or a public key line from the machine's /etc/ssh." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ホスト鍵ではありません。SHA256: フィンガープリント、またはマシンの/etc/sshにある公開鍵の行を貼り付けてください。"
          }
        },
