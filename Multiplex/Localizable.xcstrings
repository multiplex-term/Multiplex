      }
    },
    "In %@'s home" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@のホーム内"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
