    "Repeat guard: ×%lld at most, %lld–%lld ms between sends, whole burst within %lld s. Values clamp." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Repeat guard: ×%1$lld at most, %2$lld–%3$lld ms between sends, whole burst within %4$lld s. Values clamp."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "リピートガード：最大 ×%lld、送信間隔%lld–%lld ms、バースト全体は%lld秒以内。値は自動的に制限されます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
