          "stringUnit" : {
            "state" : "needs_review",
            "value" : "該機器拒絕了綁定。"
          }
        }
      }
    },
    "The machine refused: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "マシンが拒否しました：%@"
          }
        },
