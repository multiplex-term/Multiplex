    ". On Vision Pro, links glow under your eye; pinch for the same sheet." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "。Vision Proでは、視線を向けるとリンクが光ります。ピンチで同じシートが開きます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "。在 Vision Pro 上，你注視時連結會發亮；捏合可開啟同一張表單。"
          }
        }
      }
    },
    "1 session" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
