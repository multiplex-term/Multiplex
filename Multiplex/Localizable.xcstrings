      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@でmosh-serverは起動しましたが、UDPの応答が届きませんでした。moshのポート範囲（デフォルト60000-61000）についてファイアウォール／NATを確認してください。"
