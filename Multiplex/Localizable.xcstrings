    },
    "Which multiplexer the agent runs on. Leave empty for the host default." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エージェントを実行するマルチプレクサです。空欄にするとホストのデフォルトを使用します。"
