    },
    "The Mac's keychain is locked, so Claude Code shows signed out" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Macのキーチェーンがロックされているため、Claude Codeはサインアウト状態で表示されます"
