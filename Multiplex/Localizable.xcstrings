    },
    "SSH LINK — NO KEEPALIVE · RTT SAMPLED BY THE DECK PROBE · ECHO MEASURED WHILE YOU TYPE" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSHリンク — キープアライブなし · RTTはDeckのプローブで取得 · エコーは入力中に測定"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSH 連線 — 無保持連線 · RTT 由 Deck 探測取樣 · 回應在你打字時測量"
          }
        }
      }
    },
    "SSH carries both the control connection and attached terminals." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSHは制御用の接続とアタッチしたターミナルの両方を運びます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SSH 同時承載控制連線與已連接的終端機。"
          }
        }
      }
    },
    "Save" : {
